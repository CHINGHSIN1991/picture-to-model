# Phase 1 固定使用 fake provider，不需要 API key，也不會讀取 .env。
# 下列 PTM_* 設定如需自訂，請先在啟動 API 與 worker 的 shell 中 export。
# 兩個程序必須使用相同資料目錄與 owner；預設值可直接使用。
PTM_DATA_DIR=output/data
PTM_LOCAL_OWNER=local-owner
PTM_WEB_ORIGIN=http://127.0.0.1:5173

# Phase 2 之後才依供應商選型啟用；目前保留欄位，不傳入前端。
TRIPO_API_KEY=
MESHY_API_KEY=

# 後續非 AI 處理預留，Phase 1 不需要 Blender。
BLENDER_BIN=/Applications/Blender.app/Contents/MacOS/Blender
