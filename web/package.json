{
  "name": "reef-viewer",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "sync-model": "node scripts/sync-model.mjs",
    "dev": "bun run sync-model && vite --host 127.0.0.1",
    "build": "bun run sync-model && vue-tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "playwright test",
    "inspect:lighting": "node scripts/inspect-lighting.mjs",
    "mockups": "node scripts/render-mockups.mjs",
    "inspect:landing": "node scripts/inspect-landing.mjs",
    "inspect:pointer": "node scripts/inspect-pointer.mjs",
    "inspect:scroll": "node scripts/inspect-scroll.mjs",
    "render:fallback": "node scripts/render-fallback.mjs",
    "inspect:fallback": "node scripts/inspect-fallback.mjs",
    "inspect:visibility": "node scripts/inspect-visibility.mjs"
  },
  "dependencies": {
    "gsap": "3.15.0",
    "three": "0.186.1",
    "vue": "3.5.44"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "@types/stats.js": "0.17.4",
    "@types/three": "0.186.0",
    "@vitejs/plugin-vue": "6.0.10",
    "lil-gui": "0.21.0",
    "stats.js": "0.17.0",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vue-tsc": "3.3.13"
  }
}
